# ─────────────────────────────────────────────
#  DriveEase Client — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
#  All client env vars MUST start with VITE_ to be exposed by Vite.
# ─────────────────────────────────────────────

# ── API base URL ────────────────────────────
# Used when NOT using the Vite dev proxy (e.g. staging or production builds)
VITE_API_BASE_URL=http://localhost:5000/api

# ── Razorpay public key (safe to expose — this is the KEY_ID only) ───
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ── App name ────────────────────────────────
VITE_APP_NAME=DriveEase
